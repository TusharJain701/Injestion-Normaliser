{
  "name": "Ingestion-Normaliser email test set",
  "version": 1,
  "case_count": 50,
  "my_address": "mybox@gmail.com",
  "max_file_mb": 20,
  "how_to_read": {
    "mail": "The mail as it looks after parsing (same fields as mail_parser.parse_message).",
    "processing": "Simulated result for each usable file: ok (default), failed, protected, file_duplicate.",
    "setup": "Database state before the mail arrives: already_processed, blocked_sender, replies_today, replied_same_category_recently.",
    "expected.category": "The correct category.",
    "expected.reply": "true if a reply must be sent, false if none.",
    "expected.reply_to": "The address the reply must go to (only when it differs from the sender).",
    "expected.reply_contains": "Text that must appear in the reply."
  },
  "cases": [
    {
      "id": "T01",
      "group": "AUTO_GENERATED",
      "description": "Bank statement from a no-reply address",
      "mail": {
        "sender_name": "",
        "sender_email": "noreply@bank.com",
        "reply_to_email": "",
        "subject": "Your October statement",
        "body": "Your statement is attached.",
        "headers": {},
        "attachments": [
          {
            "filename": "statement.pdf",
            "size_bytes": 204800
          }
        ]
      },
      "expected": {
        "category": "AUTO_GENERATED",
        "reply": false
      }
    },
